# =====================================================================
# VARIABLES DE ENTORNO DE ZARA (asistente táctico del Señor VK)
# Copie este archivo a .env y rellene lo que use. Todo es opcional:
# sin claves, Zara recurre a Ollama local y a la voz local.
# =====================================================================

# --- Cerebros en la nube (SDK nativos, sin CLI) ---
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"         # respuesta instantánea y enrutamiento
GEMINI_DEEP_MODEL="gemini-2.5-pro"      # razonamiento profundo y código

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-haiku-latest"
ANTHROPIC_DEEP_MODEL="claude-3-7-sonnet-latest"

# --- Ollama local ---
OLLAMA_HOST="http://localhost:11434"

# --- Voz (también configurable en config/zara.toml) ---
ZARA_EDGE_VOICE="es-ES-XimenaNeural"
ZARA_EDGE_RATE="+6%"
ZARA_EDGE_PITCH="+2Hz"

# --- Almacenamiento (punto 6: I/O rápida en SSD nativo) ---
# ZARA_ROOT=""   # fuerza la raíz de datos; por defecto /mnt/almacen/ZARA (frío)
# XDG_DATA_HOME="~/.local/share"  # rutas calientes bajo ~/.local/share/zara
