# Las preferencias de Zara viven en config/ajustes.env (en el repositorio).
# Aquí solo hace falta lo privado. Cualquier variable que pongas aquí
# sustituye a la de config/ajustes.env en este equipo.

# Claves de API (opcionales: con Antigravity no hacen falta)
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
