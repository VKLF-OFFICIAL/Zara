# =====================================================================
# VARIABLES DE ENTORNO PARA ZARA v2.0 (ASISTENTE TÁCTICO SEÑOR VK)
# =====================================================================

# LLM Providers
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"

# Cerebro por defecto: "auto" (prueba Gemini/Claude, fallback Ollama) | "ollama" | "gemini" | "claude"
ZARA_DEFAULT_BRAIN="auto"

# STT Whisper
ZARA_WHISPER_MODEL="deepdml/faster-whisper-large-v3-turbo-ct2"
ZARA_WHISPER_BEAM_SIZE=5

# VAD Silero
ZARA_VAD_MIN_SILENCE_MS=700
ZARA_VAD_SPEECH_PAD_MS=350
ZARA_VAD_BARGE_IN_MS=250

# TTS
ZARA_TTS_ENGINE="edge"
ZARA_EDGE_VOICE="es-ES-XimenaNeural"
ZARA_EDGE_RATE="+6%"
ZARA_EDGE_PITCH="+2Hz"

# HUD & WebSocket
ZARA_WS_PORT=8765
