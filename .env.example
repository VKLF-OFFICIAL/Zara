# =====================================================================
# VARIABLES DE ENTORNO PARA ZARA (ASISTENTE TÁCTICO DEL SEÑOR VK)
# =====================================================================

# LLM Providers
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
OLLAMA_HOST="http://localhost:11434"
# Déjalo vacío para que Zara autodetecte el modelo instalado (`ollama list`).
# Solo rellénalo si quieres fijar uno en concreto entre varios instalados.
OLLAMA_MODEL=""

# Cerebro por defecto: "auto" | "gemini_live" | "ollama" | "gemini" | "claude"
ZARA_DEFAULT_BRAIN="auto"

# Gemini Live (Streaming Bidireccional nativo Audio <-> Audio de ultra-baja latencia)
ZARA_GEMINI_LIVE_MODEL="auto"
ZARA_GEMINI_LIVE_VOICE="Aoede"

# STT Whisper
# "auto": large-v3-turbo si hay GPU CUDA, "small" en CPU. Fija "tiny"/"base" para ir más rápido.
ZARA_WHISPER_MODEL="auto"
ZARA_WHISPER_BEAM_SIZE=1

# VAD Silero
ZARA_VAD_MIN_SILENCE_MS=500
ZARA_VAD_SPEECH_PAD_MS=350
ZARA_VAD_BARGE_IN_MS=250

# TTS
ZARA_TTS_ENGINE="edge"
ZARA_EDGE_VOICE="es-ES-XimenaNeural"
ZARA_EDGE_RATE="+6%"
ZARA_EDGE_PITCH="+2Hz"

# HUD & WebSocket
ZARA_WS_PORT=8765
