# =====================================================================
# AJUSTES DE ZARA — configuración personal del Señor VK
# =====================================================================
# Este archivo SÍ se sube a GitHub (el repositorio es público): aquí solo van
# preferencias, NUNCA claves de API, contraseñas ni datos personales.
#
# Prioridad (de mayor a menor):
#   1. Variables de entorno del sistema
#   2. .env  (local, no se sube: claves y ajustes solo para este equipo)
#   3. este archivo
# Lo que elijas en el panel de Zara (cerebro, modelo) se guarda en .env.

# --- Cerebro ---------------------------------------------------------
# "antigravity" = Gemini con la suscripción Google AI Pro, vía Antigravity CLI (agy).
# Otras opciones: "auto" | "gemini" | "gemini_live" | "claude" | "ollama"
ZARA_DEFAULT_BRAIN="antigravity"
# Modelo de Antigravity ("" = el que agy tenga por defecto; `agy models` lista los demás).
ZARA_AGY_MODEL=""
ZARA_AGY_TIMEOUT=120

# Gemini por API (solo si hay GEMINI_API_KEY en .env): "auto" elige el Flash vigente.
GEMINI_MODEL="auto"
ZARA_GEMINI_LIVE_MODEL="auto"
ZARA_GEMINI_LIVE_VOICE="Aoede"

# Ollama (local, sin internet): "" autodetecta el modelo instalado.
OLLAMA_HOST="http://localhost:11434"
OLLAMA_MODEL=""

# --- Oído (transcripción) --------------------------------------------
# "auto": large-v3-turbo con GPU NVIDIA, "small" en CPU. "base"/"tiny" = más rápido, menos preciso.
ZARA_WHISPER_MODEL="auto"
ZARA_WHISPER_BEAM_SIZE=1
ZARA_VAD_MIN_SILENCE_MS=500
ZARA_VAD_SPEECH_PAD_MS=350
ZARA_VAD_BARGE_IN_MS=250

# --- Voz -------------------------------------------------------------
ZARA_TTS_ENGINE="edge"
ZARA_EDGE_VOICE="es-ES-XimenaNeural"
ZARA_EDGE_RATE="+6%"
ZARA_EDGE_PITCH="+2Hz"
